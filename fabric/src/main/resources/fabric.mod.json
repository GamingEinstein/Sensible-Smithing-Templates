{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/sensible-smithing-templates/",
        "sources": "https://github.com/GamingEinstein/Sensible-Smithing-Template",
        "issues": "https://github.com/GamingEinstein/Sensible-Smithing-Template/issues"
    },
    "license": "${license}",
    "icon": "logo.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.gamingeinstein.sensiblesmithingtemplates.SensibleSmithingTemplatesFabric"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17"
    }
}
  